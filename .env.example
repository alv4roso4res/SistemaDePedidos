# Copie este arquivo para .env e preencha com os seus valores.
#   cp .env.example .env
#
# ATENCAO (Windows): salve o .env em UTF-8 SEM BOM. O PowerShell 5.1 grava BOM
# por padrao (Out-File -Encoding utf8), e a biblioteca que le o arquivo rejeita
# a primeira linha com o erro "Malformed entry", derrubando a aplicacao.
# Copiar com `cp` / `copy` preserva a codificacao correta.
#
# O .env NAO e versionado (esta no .gitignore) e nunca deve conter valores reais
# neste arquivo de exemplo. Em producao, defina estas variaveis no ambiente do
# container / plataforma de deploy em vez de usar um arquivo .env.

# Perfil ativo: dev (H2 em memoria) ou prod (PostgreSQL / Supabase)
SPRING_PROFILES_ACTIVE=

# ---------------------------------------------------------------------------
# Banco de dados (obrigatorio apenas quando SPRING_PROFILES_ACTIVE=prod)
# ---------------------------------------------------------------------------
# Pegue os dados em: Supabase -> Project Settings -> Database -> Connection string
#
# Opcao recomendada para containers: Transaction Pooler (porta 6543).
# Com o pooler em modo transaction e obrigatorio desativar os prepared
# statements do driver com prepareThreshold=0, senao a conexao quebra.
#
#   DB_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
#   DB_USERNAME=postgres.<project-ref>
#
# Conexao direta (porta 5432) — atencao: e IPv6-only no plano gratuito:
#
#   DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
#   DB_USERNAME=postgres

DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Opcionais (os valores abaixo sao os padroes)
# ---------------------------------------------------------------------------
# Tamanho do pool.
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=1

# Estrategia de schema do Hibernate: update | validate | none
DDL_AUTO=update

# Porta HTTP da aplicacao
PORT=8080
